# Copy to .env (git ignores it). Everything here is optional.

# Art generation (concepts, rigs, scenery) through OpenRouter. Without it, use
# STUDIO_ART_BACKEND=fake for scripted art.
OPENROUTER_API_KEY=

# Useful overrides (see docs/reference.md for the full list):
# STUDIO_PORT=5173
# STUDIO_DATA_DIR=/path/to/project          # default: projects/default
# STUDIO_CHAT_BACKEND=fake                  # scripted chat model, no Claude login needed
# STUDIO_ART_BACKEND=fake                   # scripted art models, no spend
# STUDIO_ART_BUDGET=0.25                    # USD cap per art job
# GODOT=/path/to/godot                      # if godot isn't on PATH
