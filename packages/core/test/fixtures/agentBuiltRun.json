transitions": [{"when": {"type": "after", "seconds": 0.8}, "to": "patrol"}]}}, "interrupts": []}}, {"id": "guardian_crab", "name": "Guardian Crab", "color": "#d9825b", "size": {"width": 150, "height": 100}, "kind": "enemy", "movement": "ground", "stats": {"knockback": 500, "health": 14, "contactDamage": 1, "armor": 0.8}, "behavior": {"initial": "dormant", "states": {"dormant": {"action": {"type": "wait"}, "transitions": [{"when": {"type": "playerWithin", "distance": 380}, "to": "rise"}]}, "rise": {"action": {"type": "telegraph", "color": "#ffd27a", "shake": true}, "transitions": [{"when": {"type": "after", "seconds": 1}, "to": "stalk"}]}, "stalk": {"action": {"type": "chase", "speed": 90, "stopDistance": 70}, "transitions": [{"when": {"type": "healthBelow", "fraction": 0.5}, "to": "enrage"}, {"when": {"type": "playerWithin", "distance": 130}, "to": "claw"}, {"when": {"type": "after", "seconds": 2.5}, "to": "slam"}]}, "claw": {"action": {"type": "strike", "windup": 0.6, "active": 0.25, "recovery": 0.8, "damage": 1, "width": 130, "height": 80, "offsetX": 90, "lunge": 120, "color": "#ff7a5a"}, "transitions": [{"when": {"type": "actionDone"}, "to": "stalk"}]}, "slam": {"action": {"type": "slam", "windup": 0.8, "height": 70, "damage": 1, "waveSpeed": 380, "waveReach": 380, "waveHeight": 28, "color": "#ffd27a"}, "transitions": [{"when": {"type": "actionDone"}, "to": "rest"}]}, "rest": {"action": {"type": "wait"}, "transitions": [{"when": {"type": "after", "seconds": 1.2}, "to": "stalk"}]}, "enrage": {"action": {"type": "telegraph", "color": "#ff5a5a", "shake": true}, "transitions": [{"when": {"type": "after", "seconds": 0.8}, "to": "hunt"}]}, "hunt": {"action": {"type": "chase", "speed": 150, "stopDistance": 70}, "transitions": [{"when": {"type": "playerWithin", "distance": 130}, "to": "claw_fast"}, {"when": {"type": "after", "seconds": 2}, "to": "slam_fast"}]}, "claw_fast": {"action": {"type": "strike", "windup": 0.4, "active": 0.25, "recovery": 0.6, "damage": 1, "width": 130, "height": 80, "offsetX": 90, "lunge": 180, "color": "#ff5a5a"}, "transitions": [{"when": {"type": "actionDone"}, "to": "hunt"}]}, "slam_fast": {"action": {"type": "slam", "windup": 0.5, "height": 80, "damage": 1, "waveSpeed": 480, "waveReach": 520, "waveHeight": 28, "color": "#ff5a5a"}, "transitions": [{"when": {"type": "actionDone"}, "to": "rest_fast"}]}, "rest_fast": {"action": {"type": "wait"}, "transitions": [{"when": {"type": "after", "seconds": 0.7}, "to": "hunt"}]}}, "interrupts": []}}], "wiki": {"pages": [{"id": "overview", "kind": "overview", "title": "The Sunken Observatory", "summary": "A diver descends into a drowned observatory to restart its great lens.", "body": "A lone diver explores a sunken observatory, once a place for reading the stars, now flooded and overgrown with coral. At its heart sits the great lens, dark for generations. The goal is to climb from the drowned entrance to the star chamber and wake it.\n\n## Structure\n- [[flooded_dome]]: where the journey starts.\n- [[pump_works]]: the machinery that holds the water in, guarded by the [[guardian_crab]].\n- [[star_chamber]]: the lens itself, where the game ends.\n\n## Tone\nQuiet, submerged and lonely, with slow light through green water and the groan of old metal. Wonder more than dread. The place is dormant rather than hostile.\n\n## Themes\n- Restoration: bringing something forgotten back to life.\n- Nature reclaiming the made: coral growing over brass.\n- Looking up from the deep: reaching for light from the bottom.\n\n## Cast\n[[wanderer]] is the player. The wildlife includes the [[crawler]] and the [[charger]].", "fields": {}, "status": "draft"}, {"id": "wanderer", "kind": "character", "title": "Wanderer", "summary": "The diver who descends to restart the great lens.", "body": "The Wanderer is a solitary diver who enters the sunken observatory with one purpose: to relight the great lens in the [[star_chamber]].\n\nThey have no voice and no companions. Their story is told by the places they pass through, from the [[flooded_dome]] to the [[pump_works]]. Their past is left open: why they came and who sent them are still undecided.\n\nThey meet the [[crawler]] and [[charger]] as hostile wildlife and must get past the [[guardian_crab]] to go on.", "fields": {"role": "player character", "appearance": "A diver in a patched, brass-collared suit with a round glass helmet and a small lamp.", "motivation": "To restart the great lens of the observatory."}, "characterId": "player", "status": "draft"}, {"id": "crawler", "kind": "character", "title": "Crawler", "summary": "A slow, shell-backed scuttler that patrols floors and walls.", "body": "The Crawler is a small coral-crusted scuttler. It paces back and forth along floors and ledges and hurts only on contact.\n\nIt is the first enemy the [[wanderer]] meets, mostly in the [[flooded_dome]], and it teaches the player to time jumps over a predictable threat. Its shell resembles the guardian's, hinting that the [[guardian_crab]] is a much larger relative.", "fields": {"role": "enemy", "behavior": "Patrols a fixed stretch of surface and turns at edges. It does not chase.", "habitat": "flooded_dome"}, "characterId": "crawler", "status": "draft"}, {"id": "charger", "kind": "character", "title": "Charger", "summary": "An aggressive creature that spots the player and rushes at them.", "body": "The Charger lives in the cramped passages of the [[pump_works]], drawn to the vibration of the old machinery.\n\nIt waits, then rushes at the [[wanderer]] in a straight line. After a charge it is briefly stunned, which is the player's chance to strike or slip past. It is a sharper test than the [[crawler]]: it demands reaction rather than timing.", "fields": {"role": "enemy", "behavior": "Idles until the player is in line of sight, then charges in a straight line and pauses to recover.", "habitat": "pump_works"}, "characterId": "charger", "status": "draft"}, {"id": "guardian_crab", "kind": "character", "title": "Guardian Crab", "summary": "A huge coral-encrusted crab that blocks the way into the pump works.", "body": "The Guardian Crab squats at the passage between the [[flooded_dome]] and the [[pump_works]]. Coral has grown through its shell until it is hard to tell where the creature ends and the structure begins.\n\nIt does not hunt. It defends the gate, and it rises when the [[wanderer]] approaches. It is a larger kin to the [[crawler]]. Beating it opens the way to the machinery.", "fields": {"role": "boss", "location": "flooded_dome", "appearance": "A giant crab whose shell is grown over with coral and barnacles, with one oversized claw."}, "status": "draft"}, {"id": "flooded_dome", "kind": "place", "title": "The Flooded Dome", "summary": "The drowned entrance hall of the observatory, where the Wanderer begins.", "body": "The Flooded Dome is where the [[wanderer]] first enters. Light from the surface still filters through cracks in the glass, and the room feels almost peaceful.\n\nThe [[crawler]] patrols here, so the player can learn the basics safely. At the far end, a passage leads on to the [[pump_works]], and the [[guardian_crab]] sits in front of it.", "fields": {"mood": "Calm, green and open, with shafts of light from broken glass above.", "appearance": "A vast cracked glass dome, half underwater, with fallen star charts and coral-covered brass rails.", "role": "starting region"}, "status": "draft"}, {"id": "pump_works", "kind": "place", "title": "The Pump Works", "summary": "The flooded machine halls that once held the sea out of the observatory.", "body": "The Pump Works lies behind the [[guardian_crab]]. Its great pumps once drained the lower halls; they stopped long ago and the sea came in.\n\nThe [[charger]] lurks in the tight passages. The way upward to the [[star_chamber]] runs through the machinery, and the state of the pumps is tied to the water level that keeps the lens out of reach.", "fields": {"mood": "Dark, cramped and echoing with dead machinery.", "appearance": "Huge pipes, valves and cogs furred with coral, narrow walkways and flooded sumps.", "role": "middle region"}, "status": "draft"}, {"id": "star_chamber", "kind": "place", "title": "The Star Chamber", "summary": "The dry, silent top of the observatory, home of the great lens.", "body": "The Star Chamber is the end of the journey. Here the great lens waits, dark and still.\n\nWhen the [[wanderer]] restarts it, light returns to the observatory and the game ends. The chamber is reached through the [[pump_works]].", "fields": {"mood": "Hushed and reverent, lit faintly by stars through the lens.", "appearance": "A circular room with a ceiling of black glass, and the great lens at its centre on a brass mount.", "role": "ending region"}, "status": "draft"}]}, "progression": {"start": "flooded_dome", "ending": "star_chamber", "abilities": [{"id": "dash", "name": "Current Dash", "mechanic": "dash", "obtainedIn": {"regionId": "flooded_dome", "source": "boss", "requires": []}, "status": "draft"}, {"id": "pump_key", "name": "Pump Key", "mechanic": "key", "obtainedIn": {"regionId": "pump_works", "source": "pickup", "requires": ["dash"]}, "status": "draft"}], "regions": [{"id": "pump_works", "name": "The Pump Works", "rooms": 3, "enemies": ["charger", "crawler"], "wikiPageId": "pump_works", "status": "draft"}, {"id": "star_chamber", "name": "The Star Chamber", "rooms": 2, "enemies": [], "wikiPageId": "star_chamber", "status": "draft"}, {"id": "flooded_dome", "name": "The Flooded Dome", "rooms": 3, "enemies": ["crawler"], "wikiPageId": "flooded_dome", "status": "draft"}], "connections": [{"id": "dome_to_pumps", "from": "flooded_dome", "to": "pump_works", "oneWay": false, "requires": [], "status": "draft"}, {"id": "pumps_to_chamber", "from": "pump_works", "to": "star_chamber", "oneWay": false, "requires": ["pump_key"], "status": "draft"}], "beats": []}, "art": {"direction": {"style": "Hand-drawn 2D game art. Bold, readable silhouettes built from simple shapes; thick dark ink 